    "fussnoten": [
      {
        "nr": 1,
        "text": "Im Auktionskatalog Zürich 1970 sowie im Auktionskatalog Zürich 1996 wurde das Werk eindeutig Ferdinand Hodler zugeschrieben. Der erstere Katalog erwähnt eine Echtheitsbestätigung von Hodler-Experte Jura Brüschweiler. Müller 2017 zufolge handelt es sich um kein authentisches Werk, siehe auch Fn. 3."
      },
      {
        "nr": 2,
        "text": "Werktitel nach Müller 2017."
      },
      {
        "nr": 3,
        "text": "Müller 2017 zufolge ist die Signatur nicht authentisch."
      }
    ]
  },
